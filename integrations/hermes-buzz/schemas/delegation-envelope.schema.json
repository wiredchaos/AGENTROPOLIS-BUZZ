{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentropolis.local/schemas/hermes-buzz/delegation-envelope.schema.json",
  "title": "Hermes Buzz Delegation Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "community_id",
    "channel_id",
    "thread_root_event_id",
    "request_event_id",
    "from_agent",
    "to_agent",
    "action",
    "capability_ceiling",
    "approval_state"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "task_id": { "type": "string", "minLength": 1, "maxLength": 160 },
    "community_id": { "type": "string", "minLength": 1 },
    "channel_id": { "type": "string", "minLength": 1 },
    "thread_root_event_id": { "type": "string", "minLength": 1 },
    "request_event_id": { "type": "string", "minLength": 1 },
    "from_agent": { "type": "string", "minLength": 1 },
    "to_agent": { "type": "string", "minLength": 1 },
    "action": {
      "type": "string",
      "enum": ["research", "verify", "correct", "synthesize", "review", "operate"]
    },
    "instructions": { "type": "string", "maxLength": 8000 },
    "claim_ids": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "artifact_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "capability_ceiling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allow", "deny"],
      "properties": {
        "allow": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "deny": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "approval_state": {
      "type": "string",
      "enum": ["not-required", "pending", "approved", "denied"]
    },
    "approval_event_id": { "type": ["string", "null"] },
    "created_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": ["string", "null"], "format": "date-time" }
  }
}
